{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hu553in/common-things//presets/renovate/bun"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track ascii-image-converter release and checksum",
      "managerFilePatterns": [
        "/^action\\.yml$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "ASCII_IMAGE_CONVERTER_SHA256:[ \\t]*(?<currentDigest>[a-f0-9]{64})\\r?\\n[ \\t]*ASCII_IMAGE_CONVERTER_VERSION:[ \\t]*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "TheZoraiz/ascii-image-converter",
      "versioningTemplate": "semver"
    }
  ]
}
